namespace Base;

@Primitive
pub struct I64
{
    @Intrinsic
    pub fun ToString(): String;

    @Intrinsic
    pub fun AddWrapped(right: I64): I64;

    pub fun +(right: I64): I64
    {
        let max = 9223372036854775807_i64;
        let min = -9223372036854775808_i64;

        if ((right > 0_i64 && self > max.SubWrapped(right)) ||
            (right < 0_i64 && self < min.SubWrapped(right)))
        {
            Panic("Integer overflow.");
        }

        return AddWrapped(right);
    }

    @Intrinsic
    pub fun SubWrapped(right: I64): I64;

    pub fun -(right: I64): I64
    {
        let max = 9223372036854775807_i64;
        let min = -9223372036854775808_i64;

        if ((right < 0_i64 && self > max.AddWrapped(right)) ||
            (right > 0_i64 && self < min.AddWrapped(right)))
        {
            Panic("Integer overflow.");
        }

        return SubWrapped(right);
    }

    pub fun -(): I64
    {
        let min = -9223372036854775808_i64;
        if (self == min)
            Panic("Integer overflow.");
        return 0_i64.SubWrapped(self);
    }

    @Intrinsic
    pub fun MulWrapped(right: I64): I64;

    pub fun *(right: I64): I64
    {
        let max = 9223372036854775807_i64;
        let min = -9223372036854775808_i64;

        if ((self == -1_i64 && right == min) || (self == min && right == -1_i64))
            Panic("Integer overflow.");    
            
        let wrappedResult = MulWrapped(right);
        if (right != 0_i64 && wrappedResult / right != self)
            Panic("Integer overflow.");

        return wrappedResult;
    }

    @Intrinsic
    fun DivUnchecked(right: I64): I64;

    pub fun /(right: I64): I64
    {
        let min = -9223372036854775808_i64;

        if (right == 0_i64)
            Panic("Division by zero.");
        if (self == min && right == -1_i64)
            Panic("Integer overflow.");
        
        return DivUnchecked(right);
    }
    


    @Intrinsic
    pub fun <(right: I64): Bool;
    
    pub fun <=(right: I64): Bool
        = self < right || self == right;
        
    pub fun >(right: I64): Bool
        = right < self;
        
    pub fun >=(right: I64): Bool
        = self > right || self == right;
        
    @Intrinsic
    pub fun ==(right: I64): Bool;
    
    pub fun !=(right: I64): Bool
        = !(self == right);
}