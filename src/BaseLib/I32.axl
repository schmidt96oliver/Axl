namespace Base;

@Primitive
pub struct I32
{
    pub const Min: I32 = -2147483648;
    pub const Max: I32 = 2147483647;

    @Intrinsic
    pub fun ToString(): String;
    
    @Intrinsic
    pub fun AddWrapped(right: I32): I32;

    pub fun +(right: I32): I32
    {
        if (right > 0 && self > Max.SubWrapped(right) ||
            right < 0 && self < Min.SubWrapped(right))
        {
            Panic("Integer overflow.");
        }

        return AddWrapped(right);
    }

    @Intrinsic
    pub fun SubWrapped(right: I32): I32;

    pub fun -(right: I32): I32
    {
        if (right < 0 && self > Max.AddWrapped(right) ||
            right > 0 && self < Min.AddWrapped(right))
        {
            Panic("Integer overflow.");
        }

        return SubWrapped(right);
    }

    pub fun -(): I32
    {
        if (self == Min)
            Panic("Integer overflow.");
        return 0.SubWrapped(self);
    }

    @Intrinsic
    pub fun MulWrapped(right: I32): I32;

    pub fun *(right: I32): I32
    {
        if (self == -1 && right == Min || self == Min && right == -1)
            Panic("Integer overflow.");    
            
        let wrappedResult = MulWrapped(right);
        if (right != 0 && wrappedResult / right != self)
            Panic("Integer overflow.");

        return wrappedResult;
    }

    @Intrinsic
    fun DivUnchecked(right: I32): I32;

    pub fun /(right: I32): I32
    {
        if (right == 0)
            Panic("Division by zero.");
        if (self == Min && right == -1)
            Panic("Integer overflow.");
        
        return DivUnchecked(right);
    }
    
    
    @Intrinsic
    pub fun <(right: I32): Bool;
    
    pub fun <=(right: I32): Bool
        = self < right || self == right;
        
    pub fun >(right: I32): Bool
        = right < self;
        
    pub fun >=(right: I32): Bool
        = self > right || self == right;
        
    @Intrinsic
    pub fun ==(right: I32): Bool;
    
    pub fun !=(right: I32): Bool
        = !(self == right);
}