//--- Exclusivity/SameLocal
//@check

var a = 0;
Swap(mut a, mut a); //~error

var c = Counter(X=0);
Swap(mut c.X, mut c.X); //~error

fun Swap(mut a: I32, mut b: I32)
{
    let t = a;
    a = b;
    b = t;
}

struct Counter
{
    pub X: I32;
}

//--- Exclusivity/ReceiverAndArgument
//@check

var c = Counter(X=0);
c.AddTo(mut c.X); //~error

struct Counter
{
    pub X: I32;

    pub mut fun AddTo(mut target: I32)
    {
        target = target + X;
    }
}

//--- Exclusivity/ThroughMutReturn
//@check

var c = Counter(X=0);
Bump(mut c.Value(), mut c); //~error

fun Bump(mut x: I32, mut c: Counter)
{
    x = x + 1;
    c = Counter(X=0);
}

struct Counter
{
    pub X: I32;

    pub mut fun Value(): mut I32
        = mut X;
}