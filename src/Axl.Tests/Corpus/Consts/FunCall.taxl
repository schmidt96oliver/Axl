//@run
//= 1
//= 2

PrintLine(Test.A);
PrintLine(Test.B);

fun Outer(): I32
{
    PrintLine("Not visible! Only in compiler output.");
    return 1;
}

struct Test 
{
    pub const A: I32 = Outer();
    pub const B: I32 = Inner();

    static fun Inner(): I32
    {
        PrintLine("Not visible! Only in compiler output.");
        return 2;
    }
}