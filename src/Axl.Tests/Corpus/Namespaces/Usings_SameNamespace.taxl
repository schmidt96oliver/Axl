//@run
//= yy

// Using scopes must handle usings of the same namespace.
// This enforces the binder doing lazy using scope binding.

using A;
InA();
InA2();

//---
namespace A;

using A.B;

pub fun InA() = InAB();

//---
namespace A.B;

pub fun InAB() = Print("y");

//---
namespace A;

using B;

pub fun InA2() = InAB();