//@check

// Only variables can be declared again. They can not overwrite
// anything else (funs, types) that is declared
// on the same scope.

// Reason: Funs and types are visible before they are declared.
//         Allowing shadowing in the example below would mean,
//         that 'Test' still refers to the variable, even after
//         'fun Test' has been declared in syntax order. That is
//         highly confusing and unexpected.

let StructTest = 1;     //~error CannotShadow
struct StructTest;
let StructTest = 1;     //~error CannotShadow