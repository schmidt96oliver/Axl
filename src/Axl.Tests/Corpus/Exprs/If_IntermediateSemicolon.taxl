//@run

// Semicolon can be written to separate if-branch from else-branch.
// This is purely for familiarity with C-style languages for ifs
// in statement position. For consistency it's allowed in expression
// position as well and is not required in either position.

let a = if (false) 1; else 2;
PrintLine("{a} ");
//= 2

let b = if (false) 1 else 2;
PrintLine("{b} ");
//= 2

if (false) PrintLine("n ") else PrintLine("y ");
//= y

if (false) PrintLine("n "); else PrintLine("y ");
//= y


if (2 == 1) PrintLine("n ")
else if (2 == 2) PrintLine("y ")
else PrintLine("n ");
//= y

if (2 == 1) PrintLine("n ");
else if (2 == 2) PrintLine("y ");
else PrintLine("n ");
//= y