//@check

// Module files are made up only of modules.
// Script files may not contain modules.
// Usings are fine either way.

// The first body item or module declaration determines type of file.

module Global;
var a = 2;  //~error

//---
fn A() { }

module Global;   //~error

//---
module A { }
a;          //~error

//---
module Global;

var a = 2;      //~error
a = true;       //~error

module A { }    