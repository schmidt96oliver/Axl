//@run-pass

using Standard;

// ----- Interpolation and Concatenation -----
// Concatenation is only available through string interpolation.
// The interior of an interpolation is executed as one expression,
// in that, it is different from a normal block expression.

var str1 = "Hello";
var str2 = " ";
var str3 = "World";

var helloWorld = "{str1}{str2}{str3}";
PrintLine(helloWorld);

var a = 1;
PrintLine("It is {a}");

// ------ Nested Interpolation ------
// Interpolations can contain any expression including other interpolated strings.

PrintLine("It is { if a == 1 => "A"
                   else => "B {str1}" 
                 }");

// ----- Escapes -----
// Supported: \n \r \t \{ \} \\ \"
PrintLine("Hello\nWorld");     // is two line
PrintLine("Hello \{bla\}");    // does not start formatting block
PrintLine("Hello \"bla\"");    // Hello "bla"

//=== stdout
// Hello World
// It is 1
// A
// Hello
// World
// Hello {bla}
// Hello "bla"