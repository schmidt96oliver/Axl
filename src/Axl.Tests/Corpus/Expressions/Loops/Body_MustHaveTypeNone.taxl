//@check

// The body of a loop must always have type none.
// Another type doesn't make sense, because what to do
// with this value? Discard is counter-intuitive. Breaking
// is very much unexpected.

loop => 1;      //~error TypeMismatch
loop { => 1 }   //~error TypeMismatch

loop
{
    var a = 1;
    => { }
}
loop => { }
loop { }