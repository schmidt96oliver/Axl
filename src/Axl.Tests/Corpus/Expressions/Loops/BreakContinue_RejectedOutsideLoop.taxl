//@check

break;      //~error BreakOrContinueOutsideLoop
continue;   //~error BreakOrContinueOutsideLoop

{
    break;      //~error BreakOrContinueOutsideLoop
    
    continue;   //~error BreakOrContinueOutsideLoop
}

if true => break    //~error BreakOrContinueOutsideLoop
else => continue;   //~error BreakOrContinueOutsideLoop