//@run-pass

using Standard;

var str: string = 
    {
        var str = "";
        var i = 0;
        => loop
           {
               if i >= 3 
               { 
                   str = "{str}{i}";   // i == 3
                   break str;
               }
                
               str = "{str}{i}\n";
               i += 1;
           }
    };
PrintLine(str);

//=== stdout
// 0
// 1
// 2
// 3