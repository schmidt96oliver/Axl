//@run
//= 2 1

let buffer = UnsafeMutBuffer[Item].NewUninitialized(10);
buffer.AtUnchecked(3) = Item(A = 1, B = 1);
Inc(mut buffer.AtUnchecked(3).A);

Print("{buffer.AtUnchecked(3)}");

fun Inc(mut a: I32)
{
    a = a + 1;
}

struct Item
{
    pub A: I32;
    pub B: I32;

    pub fun ToString(): String
        = "{A} {B}";
}