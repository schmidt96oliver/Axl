//@run
//= 0 1 2 0 1 2

// Fill buffer
let buffer = UnsafeMutBuffer[I32].NewUninitialized(3);
for (i in 0..buffer.Length())
{
    buffer.AtUnchecked(i) = i;
}

// Double the buffer
let doubled = UnsafeMutBuffer[I32].NewUninitialized(buffer.Length() * 2);
buffer.CopyIntoUnchecked(doubled, 0, 0, buffer.Length());
buffer.CopyIntoUnchecked(doubled, buffer.Length(), 0, buffer.Length());

// Print the doubled buffer
for (i in 0..doubled.Length())
{
    Print("{doubled.AtUnchecked(i)} ");
}