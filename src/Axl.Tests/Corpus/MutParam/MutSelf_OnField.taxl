//@run
//= 2

var o = Outer(Inner=Counter(X=0));
o.Bump();
o.Inner.Inc();
PrintLine("{o}");

struct Outer
{
    pub Inner: Counter;

    pub mut fun Bump()
    {
        Inner.Inc();
    }

    pub fun ToString(): String
        = "{Inner}";
}

struct Counter
{
    pub X: I32;

    pub mut fun Inc()
    {
        X = X + 1;
    }

    pub fun ToString(): String
        = "{X}";
}