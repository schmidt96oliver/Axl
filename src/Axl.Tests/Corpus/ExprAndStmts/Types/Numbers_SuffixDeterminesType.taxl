//@check

// The suffix determines the number types if present.

// Integral numbers
var a = 1_i32;
//~type ^^^^^ I32
var a = 1_i64;
//~type ^^^^^ I64
var a = 1_f32;
//~type ^^^^^ F32
var a = 1_f64;
//~type ^^^^^ F64

// Decimal numbers
var a = 1.1_f32;
//~type ^^^^^^^ F32
var a = 1.1_f64;
//~type ^^^^^^^ F64