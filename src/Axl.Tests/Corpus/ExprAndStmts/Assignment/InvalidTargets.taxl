//@check

// Only variables can be assigned to.

1 + 1 = true;   //~error InvalidAssignTarget

1 = 1; //~error InvalidAssignTarget

var a = 1;
if (true) a = 1; //~error InvalidAssignTarget

(a) = 1; //~error InvalidAssignTarget

a and a = 1;  //~error InvalidAssignTarget

{ } = { };      //~error InvalidAssignTarget