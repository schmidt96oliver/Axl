//@check

// The suffix determines the number types if present.

// Integral numbers
var a = 1_i32;
//~type ^^^^^ i32
var a = 1_i64;
//~type ^^^^^ i64
var a = 1_f32;
//~type ^^^^^ f32
var a = 1_f64;
//~type ^^^^^ f64

// Decimal numbers
var a = 1.1_f32;
//~type ^^^^^^^ f32
var a = 1.1_f64;
//~type ^^^^^^^ f64