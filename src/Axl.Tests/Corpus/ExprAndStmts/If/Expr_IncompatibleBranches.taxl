//@check

// In expression position, types of both branches must be equal.
// Error is reported on both branches.


var a = if (true) 1     //~error IncompatibleBranches
        else "Hello";   //~error IncompatibleBranches

var a = if (false) { }  //~error IncompatibleBranches
        else 1;         //~error IncompatibleBranches

var a = if (false) .1f32    //~error IncompatibleBranches
        else { };           //~error IncompatibleBranches

var a = if (true) 1
        else if (false) 1.1 //~error IncompatibleBranches
        else 2;             //~error IncompatibleBranches
        
var a = if (true)
            if (false) 1    //~error IncompatibleBranches
            else 1.1        //~error IncompatibleBranches
        else 1;

// Valid cases:
var a = if (true) 1 else 2;
var a = if (true) 
            if (false) 2 else 3
        else 2;