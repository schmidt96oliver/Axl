//@check

module Standard;

native("I32ToString") fn I32ToString(i: i32): string;
native("I64ToString") fn I64ToString(i: i64): string;
native("F32ToString") fn F32ToString(i: f32): string;
native("F64ToString") fn F64ToString(i: f64): string;

native("Print") fn Print(input: string): unit;

native("Panic") fn Panic(msg: string): never;
fn Panic(): never
    => Panic("");  

fn Print(i: i32)
    => Print(I32ToString(i));
fn Print(i: i64)
    => Print(I64ToString(i));
fn Print(i: f32)
    => Print(F32ToString(i));
fn Print(i: f64)
    => Print(F32ToString(i));
fn Print(b: bool)
    => Print(if (b) "true" else "false");

fn PrintLine(input: string)
    => Print("{input}\n");
    
fn PrintLine(input: i32)
{
    Print(input);
    Print("\n");
}
fn PrintLine(input: i64)
{
    Print(input);
    Print("\n");
}
fn PrintLine(input: f32)
{
    Print(input);
    Print("\n");
}
fn PrintLine(input: f64)
{
    Print(input);
    Print("\n");
}
fn PrintLine(input: bool)
{
    Print(input);
    Print("\n");
}