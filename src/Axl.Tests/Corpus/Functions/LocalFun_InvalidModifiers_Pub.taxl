//@check

// 'pub' is never valid on local funs, because they must be private
// to their enclosing fun.

pub fun A() { }  //~error InvalidLocalFunModifier

{ 
    pub fun A() { }  //~error InvalidLocalFunModifier
}

fun Local()
{
    pub fun A() { }  //~error InvalidLocalFunModifier
}

struct Test 
{
    pub fun Normal()
    {
        pub fun A() { }  //~error InvalidLocalFunModifier
    }
    static fun Static()
    {
        pub fun A() { }  //~error InvalidLocalFunModifier
    }
}