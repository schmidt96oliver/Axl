//@check

// Local funs report duplicate errors.
fun Test() { }   //~error
fun Test() { }   //~error

// Also inside blocks
{
    fun InBlock() { }    //~error
    fun InBlock() { }    //~error
}

// And inside other functions
fun Outer()
{
    fun InFun() { }   //~error
    fun InFun() { }   //~error
}