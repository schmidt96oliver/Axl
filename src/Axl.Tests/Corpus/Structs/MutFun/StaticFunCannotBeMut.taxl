//@check

// Static funs do not have an instance, so they cannot mutate it.

mut fun Script() { }        //~error StaticFunCannotBeMut

struct Test 
{
    pub static mut fun StaticMut() { }      //~error StaticFunCannotBeMut
    static mut fun StaticMut2() { }         //~error StaticFunCannotBeMut
}

//---
namespace Test;
mut fun OnNamespace() { }        //~error StaticFunCannotBeMut