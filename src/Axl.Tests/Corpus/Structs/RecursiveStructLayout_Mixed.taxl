//@check


struct A { c: C; }          //~error RecursiveStructLayout
struct C { b: B; a: A; }    //~error RecursiveStructLayout
struct B { b: B; }          //~error RecursiveStructLayout

struct W[T] { x: T; }
struct X { a: W[X]; }       //~error RecursiveStructLayout
struct Y { b: X; c: Z; }    //~error RecursiveStructLayout
struct Z { d: Y; }          //~error RecursiveStructLayout