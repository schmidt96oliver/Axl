//@check

struct Test 
{
    pub X: I32;

    pub static fun Static() 
    { 
        // static members are visible implicitly
        Static();
        Method();       //~error UndefinedName
        
        let a = X;      //~error UndefinedName
        let a = self;   //~error InvalidSelfRef
        let a = self.X; //~error InvalidSelfRef
    }
    pub fun Method() 
    { 
        // Both static and instance members are visible implicitly
        Static();
        Method();
        
        let a = X;
        let a = self;
        let a = self.X;
    }
    
    pub static var fun StaticVar() { }      //~error StaticFunCannotBeVar
}

Test.Method();   //~error CannotCallWithoutReceiver
Test.Static();

let t = Test(X = 1);
t.Method();
t.Static();              //~error CannotCallWithReceiver

Test.StaticVar();