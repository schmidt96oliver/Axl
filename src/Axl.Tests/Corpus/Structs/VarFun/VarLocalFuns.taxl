//@run
//= 2
//= 2
//= 4
//= 4
//= 6
//= 6

var t = Test(Field = 1);
PrintLine(t.Get1());
PrintLine(t.Get2());
t.Set1(2);
PrintLine(t.Get1());
PrintLine(t.Get2());
t.Set2(3);
PrintLine(t.Get1());
PrintLine(t.Get2());

struct Test
{
    pub Field: I32;
    
    pub fun Get1(): I32
    {
        return Local();
        
        fun Local(): I32
        {
            return Field + self.Field;
        }
    }
    
    pub fun Get2(): I32
    {
        return Local();
        
        fun Local(): I32
        {
            return Inner();
            fun Inner(): I32
            {
                return Field + self.Field;
            }
        }
    }
    
    pub var fun Set1(n: I32)
    {
        Local(n);
        var fun Local(n: I32)
        {
            Field = n;
        }
    }
    
    pub var fun Set2(n: I32)
    {
        Local(n);
        var fun Local(n: I32)
        {
            Inner(n);
            var fun Inner(n: I32)
            {
                Field = n;
            }
        }
    }
}