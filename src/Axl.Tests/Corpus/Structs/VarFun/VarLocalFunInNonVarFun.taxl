//@check

// Local funs can only be 'var', if all of their enclosing funs are 'var'.

struct Test 
{
    Field: I32;
    
    fun NonVar()
    {
        var fun VarLocal() { }      //~error VarLocalFunInNonVarFun
        
        var fun VarIntermediate()   //~error VarLocalFunInNonVarFun
        {
            var fun VarInner() { }  //~error VarLocalFunInNonVarFun
        }
    }
    
    var fun Var()
    {
        fun NonVarMiddle()
        {
            var fun VarInner() { }  //~error VarLocalFunInNonVarFun
        }
    }
}