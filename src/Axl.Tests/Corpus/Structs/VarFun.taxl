//@check

// Var funs follow the same rules as field assignment (since they assign fields :D).

struct Test
{
    pub X: I32;
    pub Inn: Inner;
   
    pub var fun Mutate() 
    { 
        // Mutating from a var fun is allowed
        self.Mutate();
        Mutate();
        self.Inn.Mutate();
        Inn.Mutate();
        
        X = 10;
        self.X = 10;
    }
    
    pub fun Derive() 
    { 
        self.Mutate();          //~error CannotMutateReceiver
        Mutate();               //~error CannotMutateReceiver
        self.Inn.Mutate();    //~error CannotMutateReceiver
        Inn.Mutate();         //~error CannotMutateReceiver
        
        X = 10;                 //~error CannotAssign
        self.X = 10;            //~error CannotAssign
    }
    
    pub static fun Make(): Test
        = Test(X = 10, Inn = Inner(Y = 1));
}

struct Inner 
{
    pub Y: I32;
    
    pub var fun Mutate() { }
}

fun Make(): Test
    = Test(X = 10, Inn = Inner(Y = 1));

// Not through let bindings
let t = Test(X = 10, Inn = Inner(Y = 1));
t.Mutate();                 //~error CannotMutateReceiver
t.Inn.Mutate();           //~error CannotMutateReceiver

// Not through temps
Test(X = 10, Inn = Inner(Y = 1)).Mutate();        //~error CannotMutateReceiver
Test(X = 10, Inn = Inner(Y = 1)).Inn.Mutate();  //~error CannotMutateReceiver

Test.Make().Mutate();       //~error CannotMutateReceiver
Test.Make().Inn.Mutate(); //~error CannotMutateReceiver

Make().Mutate();       //~error CannotMutateReceiver
Make().Inn.Mutate(); //~error CannotMutateReceiver

// Through var is allowed
var t = t;
t.Mutate();
t.Inn.Mutate();