//@check

// Private members are not accessible from the outside.

struct Test 
{ 
    X: I32; 
    fun Private() { }
    mut fun MutPrivate() { }
    static fun StaticPrivate() { }
    
    // Private members are valid inside the body
    pub static fun Make(): Test
        = Test(X = 1);  
}

var t: Test = Test(X = 1);        //~error NotAccessible
t.X = 10;           //~error NotAccessible
t.Private();        //~error NotAccessible
t.MutPrivate();     //~error NotAccessible
Print(t.X);         //~error NotAccessible

Test.StaticPrivate();       //~error NotAccessible