//@check

// Since primitives have no fields and internal memory
// representation, defining a struct initializer for
// them does not make sense.

let p = I32();      //~error CannotInitialize
let p = I64();      //~error CannotInitialize
let p = F32();      //~error CannotInitialize
let p = F64();      //~error CannotInitialize
let p = Bool();     //~error CannotInitialize