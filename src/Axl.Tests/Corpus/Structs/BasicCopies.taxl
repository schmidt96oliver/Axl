//@run
//= 0 1
//= 0 0
//= 0 2
//= 1 0
//= 2 1

// Assignment and variable declaration copies the entire struct.

struct Test { pub Value: I32; }

let original = Test(Value = 0);

// Variable declaration
var a = original;
a.Value = 1;
PrintLine("{original.Value} {a.Value}");

// Assignment
a = original;
PrintLine("{original.Value} {a.Value}");
a.Value = 2;
PrintLine("{original.Value} {a.Value}");

// Original mutates
var original = Test(Value = 0);

var a = original;
original.Value = 1;
PrintLine("{original.Value} {a.Value}");

a = original;
original.Value = 2;
PrintLine("{original.Value} {a.Value}");