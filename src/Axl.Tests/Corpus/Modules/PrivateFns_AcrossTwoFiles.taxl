//@run-pass
// Private fns are visible to every direct descendant, also across multiple files

Other.Inside.InsidePublic();

//--- Other.axl
module Other;

public fn OtherPrivate()
    => Standard.PrintLine("Pshh");

//--- Other.Inside.axl
module Other.Inside;

public fn InsidePublic()
    => OtherPrivate();      // Part of module Other
    
//=== stdout
// Pshh