//@check

// Namespace declarations must come before any members or code.
// Only using directives can come before.

// This is because it would be hard to reason about members before
// the namespace decl: Do they belong in or out?

fun Test() { }

namespace A;   //~error NamespaceDeclAfterCode

//---
var a = 2;

namespace A;   //~error NamespaceDeclAfterCode

//---
using Standard;

PrintLine("1");

namespace A;   //~error NamespaceDeclAfterCode

//---
using Standard;     // usings are allowed before

namespace A;