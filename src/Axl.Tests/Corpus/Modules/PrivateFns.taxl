//@check
// Private fns are only visible to directs descendants

A.APrivate();   //~error
A.B.BPrivate(); //~error
A.C.CPrivate(); //~error

module A
{
    private fn APrivate()
    {
        B.BPrivate();   //~error
        C.CPrivate();   //~error 
    }
        
    module B        // submodule: A.B
    {
        private fn BPrivate() => APrivate();  // visible, doesn't need A.APrivate
        
        private fn CNotVisible_1() => CPrivate();         //~error
        private fn CNotVisible_2() => A.C.CPrivate();     //~error
    }
    
    module C
    {
        private fn CPrivate() => APrivate();
        
        // Adjacent's privates are not visible
        private fn BNotVisible_1() => BPrivate();       //~error
        private fn BNotVisible_2() => A.B.BPrivate();   //~error
    }
}