//@check

// For a file-scoped module declaration it makes sense to
// allow it only once per file and only before any other modules.
// Otherwise, it becomes hard to reason about module structure,
// because they modules become part of the globally declared module.

module Global;
module A { }

//---
module A 
{ 
    module NotGlobal;   //~error
}  

//---
module A { }
module Other;   //~error

//---
module Global1;
module Global2;     //~error