//TODO change to syntax [i32] for type; [i32: 1,2,3,4] for array expression

//# ---- Grammar ----
// subscript postfix on Id: a[0]  => get, set
// subscript postfix on type _as type_:  i32[]  (in type position)
// subscript postfix on type _as value_:    i32[]   (in expression position, yields empty array)
// as prefix/primary as expression: [1]

// The grammar separates: TypeSyntax and ExpressionSyntax

// TypeSyntax and ExpressionSyntax are completely separate, so cannot interfere

// ArrayTypeSyntax = TypeSyntax "[" "]"

// ArrayExpression = TypeSyntax? "[" ItemList "]"
// ItemList = (Expression | ".." Expression) ","        -> last "," can be omitted. This allows trailing comma.
// ArraySliceExpression = Expression "[" Int? ":" Int? "]"
// ArrayAccessExpression = Expression "[" Int "]"

// Type Syntax:
i32[]

//# ---- Basic Array Expression ----
// Creation only through array expressions.
// Those will do double duty, when iterators and other collections come into the language.
// For now, they are reserved for arrays :).

i32[1,2,3];                 // type i32[]; i32-array with 3 items
i32[1,2.1_f32,3];           // ERROR TypeMismatch if 2.1_f32: expected i32, got f32
i32[];                      // empty i32 array

var a: i32[] = i32[1,2,3];
var a = i32[1,2,3];

// Can be plain, type inferred from items
[1,2,3];            // type i32[]
[1_i64, 2_i64];     // type i64[]
[true, false];      // type bool[]
[true, 1];          // ERROR cannot infer array type: ambigious

// Expected type weaves into collection expression
var a: i64[] = [1,2];   // valid
var a: f32[] = [1,2];   // valid

i64[1,2];               // valid
f32[3,2];               // valid

//# ---- Repeating Array Expression ----
// TODO: what does this look like?
var a = ;

//# ---- Spread in array expression ----
var a = [1,2,3,4];
var b = [0, ..a, 5];    // == [0,1,2,3,4,5]
var c = [0, ..a[1:2], 5];   // == [0, 2, 3, 5]

//# ---- Set/Get ----
var a: i32[] = [1, 2, 3];
a[0] = 4;
a[4] = 2;   // PANIC

var first = a[0];   // inferred i32

// Index can be negative, which means from the back
Print(a[-1]);   // 3
Print(a[-2]);   // 2

//# ---- Slices ----
// We can _get_ slices:
// first is inclusive, end is exclusive:
var b = a[1:2];     // == [2, 3]
var b = a[1:1];     // PANIC

// can be from start/end
var b: i32[] = a[:1];     // == [1]
var b: i32[] = a[1:];     // == [2,3,4]

// can be combined:
var b = a[:-2];     // == [1,2]
var b = a[:-1];     // == [1,2,3]
var b = a[-2:];     // == [3,4]

// We cannot set them
a[1:2]  = [4,3];    // ERROR InvalidAssignmentTarget
// this also doesn't make sense, since the slice operator create a _new_ array.


