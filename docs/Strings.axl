// ----- Formatting -----
var a = 1;
PrintLine("It is {a}"); // print "It is 1"

// {...} are parsed and bound as block expressions, that _must_ evaluate to a primitive type.
// Concatenation and ToString is emitted manually
// When ToString trait is implemented: {...} expects type that implements ToString and lowers to that

// Only way to concat strings:
var str1 = "Hello";
var str2 = " ";
var str3 = "World";
var helloWorld = "{str1}{str2}{str3}";

// Nested is possible
PrintLine("It is { if a == 1 { "A" } else {"B {str1}" } }");

// ----- Escapes -----
"Hello\nWorld";  // is two line
"Hello \{bla\}";    // does not start formatting block
"Hello \"bla\"";    // Hello "bla"

\n \r \t \{ \} \\ \"